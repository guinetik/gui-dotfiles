# source (repo-relative) | target ($HOME expanded by bash)
# Applied by common/create_symlinks.sh with LINKS_FILE pointing here.
# No .bashrc: macOS ships bash 3.2 and the login shell is zsh.
zsh/.zshrc|$HOME/.zshrc
zsh/.zshenv|$HOME/.zshenv
zsh/.zsh_plugins.txt|$HOME/.zsh_plugins.txt
shell/aliases.sh|$HOME/.config/shell/aliases.sh
shell/functions.sh|$HOME/.config/shell/functions.sh
starship/starship.toml|$HOME/.config/starship.toml
# zsh/.zshrc switches to this one inside Claude Code sessions.
starship/starship-minimal.toml|$HOME/.config/starship-minimal.toml
git/.gitconfig|$HOME/.gitconfig
micro/settings.json|$HOME/.config/micro/settings.json
ghostty/config|$HOME/.config/ghostty/config
mise/config.toml|$HOME/.config/mise/config.toml

# Claude Code config, shared with the Linux and Windows maps.
ai/claude/CLAUDE.md|$HOME/.claude/CLAUDE.md
ai/claude/skills|$HOME/.claude/skills
ai/claude/commands|$HOME/.claude/commands
#
# Per-platform settings, same reasoning as windows/links.psv. The mac copy
# carries statusLine and the notify hooks as bash scripts under mac/.
mac/claude-settings.json|$HOME/.claude/settings.json
